---
import Layout from "@/layouts/Layout.astro";
import { AdminDashboard } from "@/components/admin/AdminDashboard";
import { isAdminAuthenticated } from "@/lib/admin-auth";
import { listExistingWorks } from "@/lib/admin-work";

export const prerender = false;

if (!isAdminAuthenticated(Astro.cookies)) {
    return Astro.redirect("/admin/login");
}

const works = await listExistingWorks();
---

<Layout title="Admin Dashboard" description="Portfolio content admin">
    <AdminDashboard
        client:load
        initialWorks={works.map((work) => ({
            slug: work.slug,
            title: work.title,
            client: work.client,
            genre: work.genre,
            date: work.date,
        }))}
    />
</Layout>
