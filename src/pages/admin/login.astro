---
import Layout from "@/layouts/Layout.astro";
import { AdminLoginButton } from "@/components/admin/AdminLoginButton";
import { getAdminSession } from "@/lib/admin/auth";

export const prerender = false;

const session = await getAdminSession(Astro.request);
if (session) {
  return Astro.redirect("/admin");
}
---

<Layout title="Admin Login" description="Portfolio CMS Login">
  <main class="min-h-screen grid place-items-center px-4">
    <section class="w-full max-w-sm border border-border bg-card p-6 space-y-4 animate-blur-in">
      <div class="space-y-2">
        <h1 class="text-2xl font-bold tracking-tight">CMS Admin</h1>
        <p class="text-sm text-muted-foreground">
          Sign in with GitHub to access the portfolio backend.
        </p>
      </div>
      <AdminLoginButton client:load />
    </section>
  </main>
</Layout>
