---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard">
  <!-- Top bar -->
  <header class="sticky top-0 z-10 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="text-zinc-500 hover:text-zinc-300 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </a>
        <span class="text-zinc-700">/</span>
        <span class="text-sm font-medium text-zinc-200">Works</span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/admin/work/new"
          class="flex items-center gap-2 px-4 py-2 bg-zinc-100 text-zinc-900 text-sm font-medium rounded-lg hover:bg-white transition"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          New Work
        </a>
        <button
          id="logoutBtn"
          class="px-3 py-2 text-zinc-500 hover:text-zinc-300 text-sm transition"
        >
          Sign out
        </button>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <main class="max-w-6xl mx-auto px-6 py-8">
    <div id="loading" class="text-center py-20 text-zinc-600">
      <svg class="animate-spin mx-auto mb-3 w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
      </svg>
      Loading works…
    </div>
    <div id="empty" class="hidden text-center py-20">
      <p class="text-zinc-500 mb-4">No works yet</p>
      <a href="/admin/work/new" class="text-zinc-300 underline underline-offset-4 text-sm">Create your first work</a>
    </div>
    <div id="grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </main>

  <script>
    const grid = document.getElementById('grid')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;

    async function loadWorks() {
      const res = await fetch('/api/admin/works');
      const works = await res.json();

      loading.classList.add('hidden');

      if (!works.length) {
        empty.classList.remove('hidden');
        return;
      }

      grid.classList.remove('hidden');
      grid.innerHTML = works.map((w: any) => `
        <div class="group relative bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden hover:border-zinc-600 transition">
          <div class="aspect-video bg-zinc-800 overflow-hidden">
            ${w.thumbnail
              ? `<img src="${w.thumbnail}" alt="${w.title}" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition" loading="lazy" />`
              : `<div class="w-full h-full flex items-center justify-center text-zinc-600">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                  </svg>
                </div>`
            }
          </div>
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-1">
              <h3 class="font-medium text-zinc-100 text-sm leading-snug line-clamp-2">${w.title}</h3>
            </div>
            <div class="flex items-center gap-2 mt-2">
              <span class="text-xs text-zinc-600 bg-zinc-800 px-2 py-0.5 rounded-full">${w.genre ?? '—'}</span>
              <span class="text-xs text-zinc-600">${w.date ? new Date(w.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) : '—'}</span>
            </div>
            <div class="flex gap-2 mt-4">
              <a
                href="/admin/work/${w.slug}"
                class="flex-1 text-center py-1.5 text-xs font-medium bg-zinc-800 hover:bg-zinc-700 rounded-lg transition text-zinc-200"
              >Edit</a>
              <button
                data-slug="${w.slug}"
                data-sha="${w.sha}"
                data-title="${w.title}"
                class="delete-btn flex-1 py-1.5 text-xs font-medium bg-zinc-800 hover:bg-red-900/50 hover:text-red-400 hover:border-red-800/50 rounded-lg transition text-zinc-500 border border-transparent"
              >Delete</button>
            </div>
          </div>
        </div>
      `).join('');

      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const el = btn as HTMLElement;
          const title = el.dataset.title!;
          if (!confirm(`Delete "${title}"? This cannot be undone.`)) return;

          el.textContent = 'Deleting…';
          (el as HTMLButtonElement).disabled = true;

          const res = await fetch(`/api/admin/works/${el.dataset.slug}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sha: el.dataset.sha }),
          });

          if (res.ok) {
            loadWorks();
          } else {
            alert('Delete failed');
            el.textContent = 'Delete';
            (el as HTMLButtonElement).disabled = false;
          }
        });
      });
    }

    document.getElementById('logoutBtn')!.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/admin';
    });

    loadWorks();
  </script>
</AdminLayout>
